{
  "name": "@cutline/mcp-server",
  "version": "0.4.0",
  "private": true,
  "description": "Cutline MCP server: editing + perception tools for AI agents, WebSocket sync for the browser editor.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cutline-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../core/src --import tsx src/cli.ts",
    "start": "node dist/cli.js --serve-web",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx scripts/demo-agent.ts",
    "docs:tools": "tsx scripts/gen-tool-docs.ts && prettier --write ../../docs/mcp-tools.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@cutline/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "immer": "^11.1.21",
    "mediabunny": "^1.61.4",
    "opentype.js": "^2.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/opentype.js": "^1.3.10",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
